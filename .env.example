# WinMCP Configuration Template
# Do not commit your real .env with your secret token to version control!
WINMCP_HOST=127.0.0.1
WINMCP_PORT=8765
WINMCP_AUTH_TOKEN=your_generated_secret_token_here
WINMCP_BINARY_PATH=bin\windows-mcp-server.exe
WINMCP_TOOLSETS=all
WINMCP_LOG_DIR=logs
WINMCP_TUNNEL_MODE=Quick
WINMCP_TUNNEL_TOKEN=
WINMCP_CUSTOM_DOMAIN=
